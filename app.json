{
  "expo": {
    "name": "WEAR",
    "displayName": "WEAR",
    "slug": "hi1care-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/logo_wear.jpeg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/img/logo_wear.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/logo_wear.jpeg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.hi1caremobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/img/logo_wear.jpeg",
          "color": "#00A86B",
          "sounds": [
            "./assets/sounds/ceria.mp3",
            "./assets/sounds/darurat.mp3"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "56729af6-eacb-4462-b9a6-b31c370a056a"
      }
    }
  }
}
